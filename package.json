{
  "name": "quran-reader",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/generate-search-index.js && next dev --webpack",
    "build": "node scripts/generate-search-index.js && next build --webpack",
    "docs:sync:legend": "node scripts/generate-mindmap-legend.js",
    "start": "next start",
    "lint": "next lint",
    "e2e:auth:url": "node scripts/e2e-auth-url.js",
    "instant:cleanup:duplicates": "node scripts/cleanup-instant-duplicates.js",
    "instant:cleanup:duplicates:apply": "node scripts/cleanup-instant-duplicates.js --apply",
    "verify:quran": "node scripts/verify-quran-integrity.js",
    "mcp:paddle:read-only": "sh -c 'ENV=${PADDLE_ENV:-sandbox}; if [ \"$ENV\" = \"production\" ]; then KEY=${PADDLE_SECRET_KEY_PRODUCTION:-$PADDLE_SECRET_KEY}; else KEY=${PADDLE_SECRET_KEY_SANDBOX:-$PADDLE_SECRET_KEY}; fi; npx @paddle/paddle-mcp --api-key=\"$KEY\" --environment=\"$ENV\" --tools=read-only'",
    "ensure:paddle:webhook-domain": "node scripts/ensure-paddle-webhook-domain.js",
    "verify:paddle:instant": "node scripts/verify-paddle-instant.js",
    "test:fsrs:optimization": "node scripts/test-fsrs-optimization.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@hello-pangea/dnd": "^18.0.1",
    "@instantdb/admin": "^0.22.107",
    "@instantdb/core": "^0.22.107",
    "@instantdb/react": "^0.22.107",
    "@legendapp/state": "^2.1.15",
    "@open-spaced-repetition/binding": "^0.1.2",
    "@paddle/paddle-js": "^1.4.1",
    "@paddle/paddle-node-sdk": "^3.5.0",
    "@radix-ui/react-slot": "^1.2.4",
    "@react-oauth/google": "^0.13.4",
    "@t3-oss/env-nextjs": "^0.13.8",
    "@tailwindcss/postcss": "^4.1.18",
    "@tailwindcss/typography": "^0.5.19",
    "@types/mdx": "^2.0.13",
    "autoprefixer": "^10.4.23",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "idb-keyval": "^6.2.2",
    "jszip": "^3.10.1",
    "lucide-react": "^0.562.0",
    "marked": "^18.0.11",
    "next": "^16.1.2",
    "next-mdx-remote": "^6.0.0",
    "postcss": "^8.5.6",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "sql.js": "^1.14.2",
    "tailwind-merge": "^2.0.0",
    "tailwindcss": "^4.1.18",
    "tldraw": "3.15.5",
    "ts-fsrs": "^5.2.3",
    "zod": "^4.3.6"
  },
  "eslintConfig": {
    "extends": [
      "next/core-web-vitals"
    ]
  },
  "devDependencies": {
    "@ducanh2912/next-pwa": "^10.2.9",
    "@paddle/paddle-mcp": "^0.1.3",
    "@playwright/test": "^1.57.0",
    "@types/node": "^20.14.12",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/sql.js": "^1.4.11",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.0.0",
    "minimatch": "^9.0.3",
    "typescript": "^5.5.4",
    "webpack": "^5.105.2"
  }
}
